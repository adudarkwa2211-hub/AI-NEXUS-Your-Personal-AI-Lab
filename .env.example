# Copy this file to .env and adjust values as needed.

# sentence-transformers multilingual MiniLM (do not replace)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Qwen2.5 Instruct checkpoint used for generation (do not replace the family)
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

DOCUMENTS_DIR=backend/data/documents
INDEX_DIR=backend/data/indexes

TOP_K=4
MAX_NEW_TOKENS=256
CHUNK_SIZE=700
CHUNK_OVERLAP=100
SCORE_THRESHOLD=0.15
CLASSIFIER_MODEL_DIR=backend/data/models/classifier
CLASSIFIER_MIN_CONFIDENCE=0.5

# Object detection (YOLO11n pretrained on COCO)
DETECTOR_MODEL=yolo11n.pt
DETECTOR_CONFIDENCE=0.25
MAX_UPLOAD_MB=8

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
